# Copy to .env and fill in values. Never commit .env.

# Server
PORT=3000
NODE_ENV=development

# Database (Postgres on RDS, used by Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/pinly?schema=public"

# AWS
# Locally, credentials come from your AWS profile / SSO (`aws login`), not this file.
# In ECS the task role provides them.
AWS_REGION=us-east-1
# AWS_PROFILE=pinly-dev
S3_BUCKET_NAME=

# Auth (third-party provider, TBD)
# Add the provider's server-side keys here once chosen, e.g.:
# AUTH_SECRET_KEY=
