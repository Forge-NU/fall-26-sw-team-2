// One photo with optional text, location, and trip (#23 STORY-1). Visible to
// everyone until expires_at. Unless keep_on_trip is set, the cleanup job then
// deletes the row and its S3 object. A kept story stays on its trip's page.
// The API sets created_at and expires_at from the database's clock, the one
// reads compare against. The expires_at default covers direct inserts.
// story_date is the day the story is from (within its trip's dates, or today
// without a trip). It only orders kept stories on the trip page; expiry is
// still 24 hours after created_at.
// Check constraints (added in the migration):
// - keep_on_trip requires trip_id
// - at most one of location_id and custom_location_name is set
model Story {
  id                 String   @id @default(uuid()) @db.Uuid
  ownerId            String   @map("owner_id")
  tripId             String?  @map("trip_id") @db.Uuid
  locationId         String?  @map("location_id") @db.Uuid
  customLocationName String?  @map("custom_location_name") @db.VarChar(100)
  s3Key              String   @unique @map("s3_key")
  text               String?  @db.VarChar(200)
  keepOnTrip         Boolean  @default(false) @map("keep_on_trip")
  storyDate          DateTime @map("story_date") @db.Date
  expiresAt          DateTime @default(dbgenerated("(now() + '24:00:00'::interval)")) @map("expires_at")
  createdAt          DateTime @default(now()) @map("created_at")

  owner    User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  trip     Trip?     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@index([ownerId, expiresAt])
  @@index([tripId, storyDate, createdAt])
  @@index([expiresAt])
  @@map("stories")
}
