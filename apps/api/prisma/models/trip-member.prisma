// A collaborator on someone else's trip (#131 COLLAB-1, rules in #129 DOC-3).
// The owner isn't a row here: they stay trips.owner_id. A trip has at most
// MAX_TRIP_PEOPLE people (src/trips/trip-rules.ts), counting the owner,
// collaborators and pending invites.
model TripMember {
  tripId   String   @map("trip_id") @db.Uuid
  userId   String   @map("user_id")
  joinedAt DateTime @default(now()) @map("joined_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([tripId, userId])
  // The trips you joined, for the Planning list
  @@index([userId, joinedAt])
  @@map("trip_members")
}
