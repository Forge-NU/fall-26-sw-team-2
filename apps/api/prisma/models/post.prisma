// A post's author is always its trip's owner, so there's no author_id.
// Check constraints (added in the migrations): exactly one of location_id and
// custom_location_name is set; rating is 1 to 5, and only set when location_id
// is (a custom location has no shared place to average into).
model Post {
  id                 String   @id @default(uuid()) @db.Uuid
  tripId             String   @map("trip_id") @db.Uuid
  locationId         String?  @map("location_id") @db.Uuid
  customLocationName String?  @map("custom_location_name") @db.VarChar(100)
  caption            String?  @db.VarChar(2200)
  visitedOn          DateTime @map("visited_on") @db.Date
  // Optional 1-5 star rating of the place. Counts toward the place's rating
  // once the trip is published (see locations/location-ratings.ts).
  rating             Int?     @db.SmallInt
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  trip     Trip        @relation(fields: [tripId], references: [id], onDelete: Cascade)
  location Location?   @relation(fields: [locationId], references: [id], onDelete: Restrict)
  media    PostMedia[]

  @@index([tripId, visitedOn, createdAt])
  @@index([locationId])
  @@index([createdAt])
  @@map("posts")
}
