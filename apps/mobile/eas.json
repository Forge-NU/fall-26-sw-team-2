{
  "cli": {
    "version": ">= 24.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "channel": "development"
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "staging": {
      "distribution": "internal",
      "environment": "preview",
      "channel": "staging"
    },
    "pr-preview": {
      "distribution": "store",
      "environment": "preview",
      "autoIncrement": true,
      "channel": "pr-preview"
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "autoIncrement": true,
      "channel": "production"
    }
  }
}
