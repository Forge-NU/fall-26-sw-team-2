# Copy to .env and fill in values. Never commit .env.
# EXPO_PUBLIC_* vars are bundled into the app and visible to anyone, so no secrets here.

# Base URL of the NestJS API. On a physical device use your machine's LAN IP, not localhost.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Which endpoints return mock data (see docs/process/mobile-data-layer.md):
# auto (default) mocks only endpoints that aren't live yet, all mocks every
# endpoint that has a mock, none turns mocks off.
# EXPO_PUBLIC_API_MOCKS=auto

# Fake the API in the app (uploads included) until sign-in works. Never set this in a build.
# EXPO_PUBLIC_USE_MOCK_API=true

# Auth (third-party provider, TBD)
# Add the provider's publishable/client key here once chosen, e.g.:
# EXPO_PUBLIC_AUTH_PUBLISHABLE_KEY=

# Maps (provider TBD)
# EXPO_PUBLIC_MAPS_API_KEY=

# Mapbox public token (pk.*) for place search in the location picker. Without
# it, or while USE_MOCK_API is on, search uses a few mock places.
# EXPO_PUBLIC_MAPBOX_TOKEN=
